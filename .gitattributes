# Preserve the exact upstream bytes on Windows as well as Unix.
rendering/bevy-explorer/source/** -text
library/vendor/rusty_enet/** -text -whitespace

# The Explorer end-to-end suite's visual scenes and their references (apps/bevy-explorer/e2e).
apps/bevy-explorer/e2e/scenes/**/*.[gG][lL][bB] filter=lfs diff=lfs merge=lfs -text
apps/bevy-explorer/e2e/scenes/**/*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
apps/bevy-explorer/e2e/scenes/**/*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
apps/bevy-explorer/e2e/scenes/**/*.[jJ][pP][eE][gG] filter=lfs diff=lfs merge=lfs -text
apps/bevy-explorer/e2e/references/**/*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text

# The vendored docs.decentraland.org media (apps/sites/content/docs, apps/sites/scripts/gen-docs-content.mts)
# lives in Git LFS; its Markdown, JSON manifests and search index stay plain git.
apps/sites/content/docs/**/*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
apps/sites/content/docs/**/*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
