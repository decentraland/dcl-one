# The UUAV native runtime set (library/uuav/dist/<target>): the prebuilt uuav-helper and the
# FFmpeg/libva libraries it links, locked by tooling/uuav/uuav-binaries.lock.json.
library/uuav/dist/**/*.dylib filter=lfs diff=lfs merge=lfs -text
library/uuav/dist/**/*.dll filter=lfs diff=lfs merge=lfs -text
library/uuav/dist/**/*.so filter=lfs diff=lfs merge=lfs -text
library/uuav/dist/**/*.so.* filter=lfs diff=lfs merge=lfs -text
library/uuav/dist/**/uuav-helper filter=lfs diff=lfs merge=lfs -text
library/uuav/dist/**/uuav-helper.exe filter=lfs diff=lfs merge=lfs -text
# The license texts next to them are hashed by the lock too: no CRLF on Windows checkouts.
library/uuav/dist/**/*.txt text eol=lf
# The lock digests these as raw bytes; a checkout with core.autocrlf=true must not relock to
# digests no other host reproduces.
library/uuav/**/*.rs text eol=lf
library/uuav/**/*.toml text eol=lf
library/uuav/**/*.lock text eol=lf
library/uuav/**/*.sb text eol=lf
library/uuav/**/*.sh text eol=lf
tooling/uuav/*.sh text eol=lf
tooling/uuav/uuav-binaries.lock.json text eol=lf
