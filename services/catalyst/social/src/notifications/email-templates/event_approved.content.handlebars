<table style="width: 100%; max-width: 600px; margin: 0 auto; text-align: center;">
  <tr>
    <td>
      <p
        style="color: #43404A; text-align: center; font-family: Inter, Arial, Helvetica, sans-serif; font-size: 14px; font-style: normal; font-weight: 700; line-height: 24px;">
        Your hangout &lsquo;<span style="color: #FF2D55; font-family: Inter, Arial, Helvetica, sans-serif; font-size: 14px; font-style: normal; font-weight: 700; line-height: 24px;">{{metadata.title}}</span>&rsquo; has been approved. You can find it in My Hangouts. Invite your friends or copy the link to share it!
      </p>
    </td>
  </tr>
  <tr>
    <td>
      <img
        src="{{metadata.image}}"
        alt="Hangout Image"
        style="width: 100%; max-width: 600px; border-radius: 12px;" />
    </td>
  </tr>
</table>
