{
  "about": "POST /credits/authorize/batch: ONE credit (one salt) for a whole settlement group of up to 30 lines, sized from the quoted total; each line is debited in whole credits. Same conventions as credits-authorize.json.",
  "route": {
    "method": "POST",
    "path": "/credits/authorize/batch",
    "pipeline": "signedFetchMiddleware, authorizeRateLimit, authorizeUsdCreditBatchHandler",
