  "adapterCalls": [
    {
      "sql": "INSERT INTO community_members (community_id, member_address, role) SELECT cr.community_id, cr.member_address, $1 FROM community_requests cr WHERE cr.community_id = $2 AND cr.type = $3 AND NOT EXISTS ( SELECT 1 FROM community_bans cb WHERE cb.community_id = cr.community_id AND cb.banned_address = cr.member_address AND cb.active = true ) ON CONFLICT (community_id, member_address) DO NOTHING",
      "values": [
        "member",
        "AABBCCDD-0000-4000-8000-000000000001",
        "request_to_join"
      ]
    },
    {
      "sql": "DELETE FROM community_requests cr WHERE cr.community_id = $1 AND cr.type = $2 AND NOT EXISTS ( SELECT 1 FROM community_bans cb WHERE cb.community_id = cr.community_id AND cb.banned_address = cr.member_address AND cb.active = true ) RETURNING id",
      "values": [
        "AABBCCDD-0000-4000-8000-000000000001",
        "request_to_join"
      ]
    },
    {
      "sql": "INSERT INTO community_members (community_id, member_address, role) VALUES ($1, $2, $3) ON CONFLICT (community_id, member_address) DO NOTHING",
