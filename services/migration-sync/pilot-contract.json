{
  "version": 3,
  "source": "places",
  "adapter": "places_outbox_v3",
  "direction": "production_to_dcl_one",
  "authority": {
    "writes": "production",
    "jobs": "production",
    "external_effects": "production"
  },
  "activation": "rehearsal_only",
  "scope": {
    "entity_ids": "Explicit immutable UUID allowlist supplied to install-source; gateway paths must match",
    "catalogue": "Explicitly scoped Genesis metadata; canonical Places ownership, no worlds or native moderation overlays",
    "command": {
      "method": "PATCH",
      "path": "/api/places/{uuid}/favorites",
      "operation_header": "x-dcl-operation-id",
      "actor": "verified source authentication"
    },
    "source_fields": [
      "user",
      "entity_id",
      "user_activity",
      "created_at"
    ],
    "target_key": [
      "user",
      "entity_id"
    ],
    "derived_target_table": "explore.place_interaction_counts",
    "source_tables": [
      "public.places",
      "public.user_favorites",
      "public.user_likes"
    ],
    "target_tables": [
      "explore.place",
      "explore.user_favorites",
      "explore.user_likes"
    ],
    "like_fields": [
      "user",
      "entity_id",
      "like",
      "user_activity",
      "created_at",
      "updated_at"
    ],
    "derived_fields": [
      "favorites",
      "likes",
      "dislikes"
    ]
  },
  "classification": {
    "transaction_with_atomic_source_command": "native_replay_then_verify_receipt_without_domain_reapply",
    "transaction_without_command": "transformed_upsert_or_delete",
    "unrecognized_mapping_or_conflict": "block_ordered_head",
    "truncate": "reject_at_source_while_capture_installed",
    "ddl": "operator_change_requires_stop_and_compatibility_review"
  },
  "dependencies": [
    "reviewed_source_schemas",
    "inert_target_jobs_and_cleanup_intents"
  ],
  "excluded": [
    "shop",
    "credits",
    "marketplace_favorites",
    "worlds",
    "voice",
    "notifications",
    "external_providers",
    "social_workflows_beyond_settings",
    "event_workflows_beyond_schedules"
  ],
  "unverified_gates": [
    "deployed_source_writer_inventory_and_replica_configuration",
    "production_source_lock_contention_budget",
    "public_read_response_compatibility",
    "actual_scheduled_job_owned_dataset",
    "permission_and_notification_workflow",
    "failover_restore_retention_and_multi_day_soak"
  ],
  "execution": "source_only_by_default_no_client_changes",
  "optional_native_replay_gate": "stable_client_operation_identity_and_signed_gateway_aliases",
  "additional_sources": {
    "events": {
      "adapter": "events_schedules_outbox_v1",
      "source_table": "public.schedule",
      "target_table": "explore.schedules_local",
      "scope": "explicit immutable UUID allowlist",
      "mode": "source_only"
    },
    "social-settings": {
      "adapter": "social_settings_outbox_v1",
      "source_table": "public.social_settings",
      "target_table": "social.user_settings",
      "scope": "explicit immutable canonical wallets",
      "mode": "source_only",
      "restriction": "facts only; no target privacy or provider authority"
    }
  }
}
