{
  "name": "creator-hub-monorepo",
  "version": "0.0.0-dev",
  "dependencies": {
    "markdown-to-jsx": "^7.5.0"
  },
  "devDependencies": {
    "@dcl/ecs": "7.29.0",
    "@dcl/ts-proto": "1.154.0",
    "oxlint": "1.93.0",
    "playwright": "1.62.0",
    "prettier": "3.5.3",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/dcl-one.git",
    "directory": "apps/creator-hub"
  },
  "scripts": {
    "format": "prettier --check \"**/*.{js,ts,tsx,json}\" --log-level=error --ignore-path .gitignore --ignore-path .prettierignore",
    "format:fix": "prettier --write \"**/*.{js,ts,tsx,json}\" --log-level=error --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "node scripts/rolldown.js oxlint --deny-warnings .",
    "lint:fix": "pnpm run lint --fix",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck"
  },
  "type": "module"
}
