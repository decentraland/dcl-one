{
  "label": "ci:creator-hub-e2e",
  "creator-hub": [
    "apps/creator-hub/**",
    "apps/ui3/package.json",
    "apps/ui3/tsconfig.json",
    "apps/ui3/src/atoms/**",
    "apps/ui3/src/shop/land/**",
    "apps/ui3/src/explorer/components/MapSurface.tsx",
    "apps/ui3/src/explorer/components/mapsurface.css",
    "apps/ui3/src/data/site.ts",
    "apps/ui3/src/data/catalyst/client.ts",
    "apps/ui3/src/data/catalyst/landListing.ts",
    "apps/ui3/src/generated/bridge/**",
    "library/shop/checkout/chain/selection.ts",
    "library/shop/land/contracts.ts",
    "library/shop/model/address.ts",
    "library/shop/model/chain.ts",
    "library/shop/model/decimal.ts",
    "library/shop/model/money.ts",
    "library/web-core/shop-chain-env.ts",
    "library/web-core/site.ts",
    ".github/workflows/creator-hub-*",
    ".github/actions/creator-hub-*/**",
    "tooling/creator-hub-ci.py",
    "tooling/ci_paths.py",
    "tooling/tests/test_creator_hub_ci.py"
  ],
  "skip": [
    "**/*.md",
    "apps/creator-hub/docs/**",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "!apps/creator-hub/packages/inspector/test/e2e/**",
    "!apps/creator-hub/packages/creator-hub/e2e/**",
    "apps/creator-hub/packages/inspector/**/*.css"
  ],
  "every-suite": [
    "apps/creator-hub/package.json",
    "apps/creator-hub/pnpm-lock.yaml",
    "apps/creator-hub/pnpm-workspace.yaml",
    "apps/creator-hub/Makefile",
    "apps/creator-hub/e2e-selection.json",
    ".github/workflows/creator-hub-*",
    ".github/actions/creator-hub-*/**",
    "tooling/creator-hub-ci.py",
    "tooling/ci_paths.py",
    "tooling/tests/test_creator_hub_ci.py"
  ],
  "inspector": {
    "e2e": "apps/creator-hub/packages/inspector/test/e2e",
    "source": [
      "apps/creator-hub/packages/inspector/src/**",
      "apps/creator-hub/packages/asset-packs/src/**",
      "apps/ui3/src/atoms/**"
    ],
    "all": [
      "apps/creator-hub/packages/inspector/**",
      "apps/creator-hub/packages/asset-packs/**",
      "apps/creator-hub/scripts/serve-static.js",
      "apps/ui3/package.json",
      "apps/ui3/tsconfig.json"
    ]
  },
  "creator-hub-live": [
    "apps/creator-hub/patches/**",
    "apps/creator-hub/packages/creator-hub/renderer/src/modules/store/deployment/**",
    "apps/creator-hub/packages/creator-hub/renderer/src/lib/deploy.ts",
    "apps/creator-hub/packages/creator-hub/renderer/src/hooks/useDeploy.ts",
    "apps/creator-hub/packages/creator-hub/renderer/src/components/Modals/PublishProject/**",
    "apps/creator-hub/packages/creator-hub/preload/src/modules/editor.ts",
    "apps/creator-hub/packages/creator-hub/main/src/modules/cli.ts",
    "apps/creator-hub/packages/creator-hub/shared/types/deploy.ts",
    "apps/creator-hub/packages/creator-hub/e2e/specs/publish-*",
    "apps/creator-hub/packages/creator-hub/e2e/specs/signed-in.spec.ts",
    "apps/creator-hub/packages/creator-hub/e2e/setup/**",
    "apps/creator-hub/packages/creator-hub/e2e/pages/**",
    "apps/creator-hub/packages/creator-hub/e2e/fixtures.ts",
    "apps/creator-hub/packages/creator-hub/e2e/helpers/app.ts",
    "apps/creator-hub/packages/creator-hub/playwright.config.ts",
    "apps/creator-hub/packages/creator-hub/e2e/helpers/auth-identity.ts",
    "apps/creator-hub/packages/creator-hub/e2e/helpers/wallet-setup.ts",
    "apps/creator-hub/packages/creator-hub/e2e/helpers/subgraph.ts"
  ],
  "creator-hub-offline": [
    "apps/creator-hub/packages/creator-hub/**",
    "apps/creator-hub/packages/zip-extract/**",
    "apps/creator-hub/scripts/rolldown.js",
    "apps/creator-hub/scripts/rolldown-env.js",
    "apps/ui3/package.json",
    "apps/ui3/tsconfig.json",
    "apps/ui3/src/atoms/**",
    "apps/ui3/src/shop/land/**",
    "apps/ui3/src/explorer/components/MapSurface.tsx",
    "apps/ui3/src/explorer/components/mapsurface.css",
    "apps/ui3/src/data/site.ts",
    "apps/ui3/src/data/catalyst/client.ts",
    "apps/ui3/src/data/catalyst/landListing.ts",
    "apps/ui3/src/generated/bridge/**",
    "library/shop/checkout/chain/selection.ts",
    "library/shop/land/contracts.ts",
    "library/shop/model/address.ts",
    "library/shop/model/chain.ts",
    "library/shop/model/decimal.ts",
    "library/shop/model/money.ts",
    "library/web-core/shop-chain-env.ts",
    "library/web-core/site.ts"
  ]
}
