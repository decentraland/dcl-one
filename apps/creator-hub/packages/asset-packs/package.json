{
  "name": "@dcl/asset-packs",
  "description": "Decentraland Asset Packs - curated collections of 3D assets for Decentraland scenes",
  "version": "0.1.0",
  "author": {
    "email": "hello@decentraland.org",
    "name": "Decentraland Foundation",
    "url": "https://decentraland.org"
  },
  "bugs": "https://github.com/decentraland/dcl-one/issues",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-storage": "^3.1169.0",
    "@dcl/ecs-math": "2.1.0",
    "@dcl/hashing": "^3.0.4",
    "@dcl/js-runtime": "7.29.0",
    "@dcl/react-ecs": "7.29.0",
    "@dcl/sdk": "7.29.0",
    "@dcl/sdk-commands": "7.29.0",
    "prettier": "3.5.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "files": [
    "dist",
    "bin",
    "catalog.json"
  ],
  "homepage": "https://github.com/decentraland/dcl-one/tree/main/apps/creator-hub/packages/asset-packs#readme",
  "keywords": [
    "3d",
    "assets",
    "decentraland",
    "sdk7",
    "smart-items"
  ],
  "license": "ISC",
  "main": "dist/definitions.js",
  "peerDependencies": {
    "@dcl/ecs": "^7.15.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/dcl-one.git",
    "directory": "apps/creator-hub/packages/asset-packs"
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:js && pnpm run build:catalog",
    "build:catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/catalog.ts",
    "build:js": "pnpm run sdk:cast && sdk-commands build --skip-install",
    "build:lib": "pnpm run sdk:cast && tsc --project tsconfig.lib.json",
    "download": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/download.ts",
    "migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/migrate.ts",
    "sdk:cast": "tsc -p tsconfig.sdk-cast.json",
    "start": "pnpm run \"/^start:(js|lib|catalog)$/\"",
    "start:catalog": "node --watch-path=packs --watch-preserve-output --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/catalog.ts",
    "start:dev": "pnpm run \"/^start:(js:data-layer|lib|catalog)$/\"",
    "start:js": "pnpm run sdk:cast && sdk-commands start --skip-install --no-browser --port 8001",
    "start:js:data-layer": "pnpm run start:js --data-layer",
    "start:lib": "pnpm run build:lib -- --watch",
    "test": "node ../../scripts/rolldown.js vitest run --passWithNoTests",
    "typecheck": "pnpm run sdk:cast && tsc --noEmit -p tsconfig.lib.json",
    "upload": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/upload.ts",
    "validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/validate.ts"
  },
  "typings": "dist/definitions.d.ts"
}
