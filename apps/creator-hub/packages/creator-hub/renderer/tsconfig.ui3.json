{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "../../../../..",
    "outDir": "../node_modules/.cache/ui3-types",
    "tsBuildInfoFile": "../node_modules/.cache/ui3-types/tsconfig.ui3.tsbuildinfo",
    "types": ["vite/client"],
    "paths": {
      "@shop/*": ["../../../../../library/shop/*"],
      "react": ["../../../node_modules/@types/react"],
      "react-dom": ["../../../node_modules/@types/react-dom"],
      "react/jsx-runtime": ["../../../node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": [
    "../../../../ui3/src/atoms/**/*.ts",
    "../../../../ui3/src/atoms/**/*.tsx",
    "../../../../ui3/src/shop/land/LandMap.tsx",
    "../../../../ui3/src/shop/land/mapView.ts",
    "../../../../ui3/src/shop/land/tiles.ts",
    "../../../../ui3/src/shop/land/chain.ts",
    "../../../../ui3/src/shop/land/format.tsx",
    "../../../../ui3/src/shop/checkout/chain/config.ts",
    "../../../../ui3/src/shop/pageOverride.ts",
    "../../../../ui3/src/explorer/components/MapSurface.tsx",
    "../../../../ui3/src/data/site.ts",
    "../../../../ui3/src/data/catalyst/client.ts",
    "../../../../ui3/src/data/catalyst/landListing.ts",
    "../../../../ui3/src/generated/bridge/*.ts",
    "../../../../../library/shop/land/contracts.ts",
    "../../../../../library/shop/model/address.ts",
    "../../../../../library/shop/model/chain.ts",
    "../../../../../library/shop/model/decimal.ts",
    "../../../../../library/shop/model/money.ts",
    "types/ui3-land-map.d.ts"
  ],
  "exclude": ["../../../../ui3/src/**/*.test.*", "../../../../ui3/src/**/*.spec.*"]
}
