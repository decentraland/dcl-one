{
  "name": "creator-hub",
  "description": "Decentraland Creator Hub",
  "desktopName": "creator-hub.desktop",
  "version": "0.0.0-dev",
  "author": {
    "email": "hello@decentraland.org",
    "name": "Decentraland Foundation",
    "url": "https://decentraland.org"
  },
  "dependencies": {
    "@dcl/inspector": "file:../inspector",
    "@dcl/schemas": "26.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@segment/analytics-node": "2.1.2",
    "@sentry/electron": "7.20.2",
    "chokidar": "^4.0.3",
    "cross-spawn": "7.0.6",
    "dcl-catalyst-client": "21.8.1",
    "electron-log": "5.1.6",
    "electron-updater": "6.8.12",
    "immer": "10.1.1",
    "node-pty": "1.1.0",
    "npm": "10.8.1",
    "oxc-parser": "^0.60.0",
    "semver": "7.6.3",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "7.28.5",
    "@dcl/feature-flags": "^1.2.0",
    "@dcl/mini-rpc": "^1.0.7",
    "@dcl/single-sign-on-client": "0.1.0",
    "@dcl/ui-env": "1.5.1",
    "@dcl/zip-extract": "workspace:*",
    "@formatjs/icu-messageformat-parser": "2.7.8",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@playwright/test": "1.62.0",
    "@reduxjs/toolkit": "2.2.6",
    "@sentry/react": "10.75.0",
    "@sentry/vite-plugin": "11.12.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/segment-analytics": "0.0.38",
    "@types/semver": "7.5.8",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "7.0.3",
    "electron": "45.3.1",
    "electron-builder": "26.18.1",
    "happy-dom": "21.0.4",
    "markdown-to-jsx": "^7.5.0",
    "meshoptimizer": "^0.22.0",
    "playwright": "1.62.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "6.6.8",
    "react-redux": "9.1.2",
    "react-router-dom": "6.30.6",
    "sharp": "^0.35.5",
    "socket.io-client": "4.8.3",
    "typescript": "7.0.2",
    "viem": "2.57.7",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "main": "main/dist/index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/dcl-one.git",
    "directory": "apps/creator-hub/packages/creator-hub"
  },
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "build:main": "cd ./main && node ../../../scripts/rolldown.js vite build && node ../../../scripts/rolldown.js vite build --config vite.worker.config.js && node ../../../scripts/rolldown.js vite build --config vite.transcribe-worker.config.js",
    "build:preload": "cd ./preload && node ../../../scripts/rolldown.js vite build",
    "build:renderer": "cd ./renderer && node ../../../scripts/rolldown.js vite build",
    "check:optimizer-tools": "node scripts/lock-optimizer-tools.js --check",
    "check:recording-tools": "node scripts/lock-recording-tools.js --check",
    "compile": "cross-env MODE=production pnpm run build && electron-builder build --config electron-builder.cjs --dir",
    "compile:installer": "cross-env MODE=production pnpm run build && electron-builder build --config electron-builder.cjs --publish never",
    "lock:optimizer-tools": "node scripts/lock-optimizer-tools.js",
    "lock:recording-tools": "node scripts/lock-recording-tools.js",
    "postinstall": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/update-electron-vendors.js",
    "start": "pnpm run watch",
    "test": "pnpm run test:unit",
    "test:e2e": "pnpm run compile && playwright test --project=electron-offline --project=electron-live",
    "test:e2e:ci": "electron-builder build --config electron-builder.cjs --dir && playwright test --project=electron-offline",
    "test:e2e:ci:live": "playwright test --project=electron-live",
    "test:e2e:live": "pnpm run compile && playwright test --project=electron-live",
    "test:e2e:scene": "pnpm run compile && playwright test --project=electron-scene",
    "test:main": "node ../../scripts/rolldown.js vitest run -r main --passWithNoTests",
    "test:preload": "node ../../scripts/rolldown.js vitest run -r preload --passWithNoTests",
    "test:renderer": "node ../../scripts/rolldown.js vitest run -r renderer --passWithNoTests",
    "test:shared": "node ../../scripts/rolldown.js vitest run -r shared --passWithNoTests",
    "test:unit": "pnpm run test:main && pnpm run test:preload && pnpm run test:renderer && pnpm run test:shared",
    "typecheck": "pnpm run typecheck:main && pnpm run typecheck:preload && pnpm run typecheck:renderer && pnpm run typecheck:e2e && pnpm run typecheck:scripts",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "typecheck:main": "tsc --noEmit -p main/tsconfig.json",
    "typecheck:preload": "tsc --noEmit -p preload/tsconfig.json",
    "typecheck:renderer": "tsc -p renderer/tsconfig.ui3.json && tsc --noEmit -p renderer/tsconfig.json",
    "typecheck:scripts": "tsc -p scripts/assistant-manifest/tsconfig.json",
    "watch": "node scripts/watch.js"
  },
  "type": "module"
}
