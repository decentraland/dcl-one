SCENE_COMPILED_JS_SIZE_PROD=562.9k bytes
  ARTIFACT bin/index.js              10564 sha256=fa99ace30078e115
  ARTIFACT bin/scene.js               1122 sha256=f3eace6e70bdb3a2
  ARTIFACT bin/sdk-runtime.js       551234 sha256=aec756f3dbb6a9a9
