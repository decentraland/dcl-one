{
  "compilerOptions": {
    "jsx": "react",
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "src",
    "declarationDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts"],
  "extends": "@dcl/sdk/types/tsconfig.ecs7.json"
}
