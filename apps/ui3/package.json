{
  "name": "dcl-react-ui",
  "version": "0.20.0",
  "type": "module",
  "description": "React (react-dom only) re-implementation of the Decentraland client UI, aiming for near-pixel-perfect parity. Vite SPA.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/dcl-one.git",
    "directory": "apps/ui3"
  },
  "homepage": "https://github.com/decentraland/dcl-one/tree/main/apps/ui3",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:generated": "node scripts/check-generated.mts",
    "predev": "node scripts/check-generated.mts",
    "build:lib": "rm -rf dist && tsc -p tsconfig.lib.json && rsync -rlpt --prune-empty-dirs --exclude='/app/' --exclude='/test/' --exclude='/tours/' --include='*/' --include='*.css' --include='*.png' --include='*.jpg' --include='*.webp' --include='*.svg' --include='*.glb' --include='*.woff2' --include='OFL.txt' --exclude='*' src/ dist/",
    "prebuild:lib": "node scripts/check-generated.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.play.json --noEmit",
    "pretypecheck": "node scripts/check-generated.mts",
    "test": "vitest run",
    "pretest": "node scripts/check-generated.mts",
    "test:watch": "vitest",
    "gen:schema-stubs": "node scripts/gen-schema-stubs.mts",
    "gen:schema-stubs:check": "node scripts/gen-schema-stubs.mts --check",
    "gen:authoring-schemas": "node scripts/gen-authoring-schemas.mjs",
    "gen:authoring-schemas:check": "node scripts/gen-authoring-schemas.mjs --check",
    "gen:error-pages": "node scripts/gen-error-pages.mts",
    "gen:error-pages:check": "node scripts/gen-error-pages.mts --check",
    "css:inventory": "node scripts/css-inventory.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "5.104.3",
    "@walletconnect/sign-client": "2.21.0",
    "monaco-editor": "0.57.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "three": "0.186.1",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
