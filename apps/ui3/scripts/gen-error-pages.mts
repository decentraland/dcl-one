// Builds public/errors/<status>.html: self-contained branded error pages that
// nginx serves for errors it generates itself (the app is down or timed out,
// rate limits, `return 404`, oversized bodies). The app's own 4xx/5xx go
// through the React StatusPage, which shares the same copy and styles.
//
// Every page inlines its CSS, logo and art (as a data: URI) so it renders even
// when nothing behind nginx is reachable.
//
// The output is not committed: sites/scripts/sync-ui3-public.mts runs this
// before it copies ui3/public into sites/public (predev, prebuild, the Nix
// sites package), so every build renders the pages from the current copy.
//
//   node scripts/gen-error-pages.mts [--check]
import { mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { build } from "vite";

const root = new URL("../", import.meta.url);
const outDir = new URL("public/errors/", root);
const check = process.argv.includes("--check");

// statusCopy.ts is TypeScript with extensionless relative imports, so it is
// bundled (vite is the one bundler every ui3 and sites install carries) and
// imported from memory rather than executed by node directly.
const built = await build({
  configFile: false,
  root: fileURLToPath(root),
  logLevel: "silent",
  build: {
    write: false,
    minify: false,
    ssr: fileURLToPath(new URL("src/components/statusCopy.ts", root)),
    rollupOptions: { output: { format: "es" } },
  },
});
const outputs = Array.isArray(built) ? built : [built];
const chunk = outputs.flatMap((o) => ("output" in o ? o.output : [])).find((c) => c.type === "chunk");
if (!chunk) throw new Error("gen-error-pages: vite produced no chunk for src/components/statusCopy.ts");
const mod = await import(`data:text/javascript;base64,${Buffer.from(chunk.code).toString("base64")}`);
const { ART_FILES, DCL_MARK_SVG, STATIC_ERROR_STATUSES, STATUS_PAGE_STYLE, isRetryable, statusCopy } = mod as typeof import("../src/components/statusCopy");

const escape = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

const artData = new Map<string, string>();
const artUri = (path: string) => {
  if (!artData.has(path)) artData.set(path, `data:image/webp;base64,${readFileSync(new URL(`public/${path}`, root)).toString("base64")}`);
  return artData.get(path)!;
};

function page(status: number): string {
  const copy = statusCopy(status);
  const art = ART_FILES[copy.art];
  const second = isRetryable(status)
    ? `<button type="button" class="sp-btn sp-btn-secondary" onclick="location.reload()">Try again</button>`
    : `<button type="button" class="sp-btn sp-btn-secondary" onclick="history.back()">Go back</button>`;
  return `<!doctype html>
<!-- Generated by scripts/gen-error-pages.mts from src/components/statusCopy.ts. Do not edit. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>${status} · ${escape(copy.eyebrow)} · Decentraland</title>
<style>html,body{margin:0;background:#0d0c11}${STATUS_PAGE_STYLE.replace(/\s*\n\s*/g, "")}</style>
</head>
<body>
<main class="status-page" aria-labelledby="sp-title" data-status="${status}">
<div class="sp-card">
<a class="sp-logo" href="/">${DCL_MARK_SVG}<span>Decentraland</span></a>
<img class="sp-art" src="${artUri(art.path)}" width="${art.width}" height="${art.height}" alt="">
<p class="sp-code">${status} · ${escape(copy.eyebrow)}</p>
<h1 id="sp-title" class="sp-title">${escape(copy.title)}</h1>
<p class="sp-message">${escape(copy.message)}</p>
<nav class="sp-actions" aria-label="Error page navigation"><a class="sp-btn sp-btn-primary" href="/">Go to homepage</a>${second}</nav>
</div>
</main>
</body>
</html>
`;
}

mkdirSync(outDir, { recursive: true });
const expected = new Map(STATIC_ERROR_STATUSES.map((status: number) => [`${status}.html`, page(status)]));
const stale: string[] = [];
for (const [name, html] of expected) {
  const file = new URL(name, outDir);
  let current = "";
  try { current = readFileSync(file, "utf8"); } catch {}
  if (current === html) continue;
  if (check) stale.push(name);
  else writeFileSync(file, html);
}
for (const name of readdirSync(outDir)) {
  if (!expected.has(name)) stale.push(`${name} (unexpected)`);
}
if (check && stale.length) {
  console.error(`[gen:error-pages] out of date: ${stale.join(", ")}\n  run: npm run gen:error-pages`);
  process.exit(1);
}
console.log(check ? "[gen:error-pages] up to date" : `[gen:error-pages] wrote ${expected.size} pages to public/errors/`);
