# Supply-chain hardening:
# - No package can run code at install time. The packages in our locks with
#   install scripts are esbuild (no-op check; its binary ships as a platform
#   optionalDependency), fsevents (macOS-only, skipped here), and the native
#   speed-ups magic-sdk's dependencies offer (bufferutil, es5-ext, keccak,
#   secp256k1, utf-8-validate), which fall back to plain JavaScript unbuilt.
# - New deps get saved with exact versions; ranges make every lockfile
#   regeneration a chance to pull a freshly-compromised patch release.
ignore-scripts=true
save-exact=true
fund=false
