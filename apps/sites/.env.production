# Baked into the client bundle by vite at build time (VITE_*). The app and the v2
# node share one origin behind nginx, so every base is a same-origin path.
VITE_CAMERA_REEL_URL=/camera-reel-service
VITE_MARKET_URL=/marketplace-api
# Segment (core/lib/telemetry/track.ts): the deployment supplies the public write
# key and the optional first-party proxy host (`host/basePath`, no protocol) at
# runtime as SEGMENT_WRITE_KEY / SEGMENT_API_HOST, or bakes them in here as
# VITE_SEGMENT_WRITE_KEY / VITE_SEGMENT_API_HOST. Unset, track() is a no-op.
