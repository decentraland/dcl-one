{
  "name": "catalyst-sites",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync:assets": "node scripts/sync-ui3-public.mts",
    "predev": "node scripts/sync-ui3-public.mts",
    "prebuild": "node scripts/sync-ui3-public.mts",
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "node scripts/check-ui3-installed.mjs && react-router typegen && tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "schemas:honesty": "node scripts/check-schema-honesty.mts",
    "schemas:honesty:check": "node scripts/check-schema-honesty.mts --check",
    "schemas:dupes": "node scripts/check-schema-dupes.mts",
    "schemas:dupes:check": "node scripts/check-schema-dupes.mts --check",
    "schemas:dupes:baseline": "node scripts/check-schema-dupes.mts --baseline",
    "telemetry:catalog": "node scripts/telemetry-catalog.mts --write",
    "telemetry:contract": "node scripts/telemetry-catalog.mts --contract",
    "telemetry:check": "node scripts/telemetry-catalog.mts --check",
    "gen:schemas": "node scripts/gen-zod-schemas.mts",
    "gen:schemas:check": "node scripts/gen-zod-schemas.mts --check",
    "check:flowmap": "tsx scripts/check-flowmap-routes.mts",
    "smoke": "node scripts/drive/smoke.mts",
    "gen:seed-catalog": "node scripts/gen-seed-catalog.mjs",
    "gen:seed-catalog:check": "node scripts/gen-seed-catalog.mjs --check",
    "gen:docs-content": "node scripts/gen-docs-content.mts",
    "gen:docs-content:check": "node scripts/gen-docs-content.mts --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@stripe/react-stripe-js": "7.0.0",
    "@stripe/stripe-js": "10.1.0",
    "@tanstack/react-query": "5.104.3",
    "@walletconnect/sign-client": "2.21.0",
    "@xstate/react": "6.1.0",
    "fflate": "0.8.3",
    "isbot": "5.2.2",
    "marked": "18.1.1",
    "monaco-editor": "0.57.0",
    "pg": "8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "three": "0.186.1",
    "viem": "2.57.7",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dcl/asset-packs": "2.17.2",
    "@dcl/ecs": "7.30.1",
    "@react-router/dev": "8.4.0",
    "@react-router/fs-routes": "8.4.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xstate/graph": "3.0.4",
    "openapi-typescript": "7.13.0",
    "protobufjs": "7.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript6": "npm:typescript@6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
