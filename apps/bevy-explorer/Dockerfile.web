FROM nginx:1.30.7-alpine@sha256:b24de00298eb7fb23839442d46c780991be7bc7ddb081b6c0876ac777012e352
ARG VCS_REF
LABEL org.opencontainers.image.title="bevy-explorer-web" \
      org.opencontainers.image.source="https://github.com/decentraland/dcl-one" \
      org.opencontainers.image.revision=$VCS_REF \
      org.opencontainers.image.licenses="Apache-2.0"
COPY nginx.conf /etc/nginx/nginx.conf
COPY dist/web/ /usr/share/nginx/html/
USER 101:101
EXPOSE 8080
ENTRYPOINT ["nginx", "-g", "daemon off;"]
