{
  "compilerOptions": {
    "jsx": "react",
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "baseUrl": ".",
    // The Explorer page's core (library/explorer-core), where the page's wire protocol and bindings live; the
    // react-web sources this scene compiles reach it under the same name (react-web/tsconfig.json).
    "paths": { "@explorer-core/*": ["../../../../../library/explorer-core/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "assets/images/atlas/*.json"],
  "extends": "@dcl/sdk/types/tsconfig.ecs7.json"
}
