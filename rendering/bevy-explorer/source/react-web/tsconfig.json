{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    // The shared sources vite.shared.ts aliases, and the packages they import resolved to this app's copies
    // (library/ has no node_modules).
    "paths": {
      "@shop/*": ["../../../../library/shop/*"],
      "@catalyst-api/*": ["../../../../library/catalyst-api/*"],
      "@dcl/one-ui/foundations": ["../../../../library/ui/foundations/index.ts"],
      "@dcl/one-ui/foundations.css": ["../../../../library/ui/foundations/foundations.css"],
      "@dcl/one-ui/text-styles.module.css": ["../../../../library/ui/foundations/typography/text-styles.module.css"],
      "viem": ["./node_modules/viem"],
      "viem/*": ["./node_modules/viem/*"],
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vite.shared.ts"],
  // Loads bridge domains that need the scene SDK's ~system types; the bridge build checks those.
  // The signing test loads @dcl/crypto out of the bridge scene's tree, installed after this check.
  "exclude": ["src/test/bridgeSession.test.ts", "src/test/bridgeFriends.test.ts", "src/test/bridgeNotifications.test.ts", "src/test/bridgeCommunities.test.ts", "src/test/bridgeEditor.test.ts", "src/test/bridgeVoice.test.ts", "src/test/bridgeVoiceChat.test.ts", "src/test/bridgeRandomizer.test.ts", "src/test/bridgeRandomizerTokens.test.ts", "src/test/bridgeAvatarDraft.test.ts", "src/test/editorHostSigning.test.tsx"]
}
