{
  "name": "bevy-ui-react-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React DOM port of the bevy-ui-scene HUD. Hosts the engine in a same-origin iframe and drives it over a super-user bridge scene. Does NOT affect the production SDK7 scene in ../scene.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "bundle:native": "tsc --noEmit && vite build --mode native --base ./ --outDir ../assets/react-hud --emptyOutDir && npm --prefix bridge-scene run export-native",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scene-fetch": "node --test e2e/scene-fetch.browser.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "5.104.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.4",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.4",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild": false
  }
}
