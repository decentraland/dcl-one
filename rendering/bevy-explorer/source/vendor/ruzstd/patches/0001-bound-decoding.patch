+    /// Reserve a block's output before expanding literals or matches.
+    pub(crate) fn claim_output(
+        &mut self,
+        size: usize,
+    ) -> Result<(), super::sequence_execution::ExecuteSequencesError> {
+        if size > 128 * 1024 || size > self.output_remaining {
+            return Err(super::sequence_execution::ExecuteSequencesError::OutputTooLarge);
+        }
+        self.output_remaining -= size;
+        Ok(())
+    }
