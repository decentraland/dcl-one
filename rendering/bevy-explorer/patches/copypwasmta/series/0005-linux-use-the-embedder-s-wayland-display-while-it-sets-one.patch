 use crate::common::{ClipboardProvider, Result};
 
+/// The clipboards of one display. A read waits for the owner of the selection, without limit when
+/// that owner does not answer, so reads and writes have a clipboard each: a read in progress
+/// holds no write.
+struct Context {
+    /// For reads, one at a time: held for the whole wait.
+    reader: Arc<Mutex<Option<WaylandClipboard>>>,
+    /// For writes, which do not wait.
+    writer: SyncMutex<Option<WaylandClipboard>>,
+}
+
+#[derive(Clone)]
 pub struct Clipboard {
-    context: Arc<Mutex<WaylandClipboard>>,
+    context: Arc<Context>,
 }
 
 pub struct Primary {
-    context: Arc<Mutex<WaylandClipboard>>,
+    context: Arc<Context>,
+}
+
+impl Clipboard {
+    /// Stops the worker threads that serve this clipboard, its clones and its primary selection,
+    /// and waits for them. Returns whether they stopped. When `true`, none of them uses the
+    /// display, and each answers with an error. When `false`, a read was still in progress after
+    /// `wait` (a selection owner that does not answer holds a read without limit), and the
+    /// worker of the reads still uses the display. Writes stop in both cases.
+    pub fn close(&self, wait: Duration) -> bool {
+        drop(self.context.writer.lock().unwrap_or_else(PoisonError::into_inner).take());
+        let deadline = Instant::now() + wait;
+        loop {
+            if let Ok(mut reader) = self.context.reader.try_lock() {
+                drop(reader.take());
+                return true;
+            }
+            if Instant::now() >= deadline {
+                return false;
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        }
+    }
+}
+
+fn closed() -> Box<dyn std::error::Error + Send + Sync + 'static> {
+    "the Wayland display of this clipboard is closed".into()
+}
+
+/// Reads with `load` on a thread of its own, so the wait for the selection's owner holds no
+/// thread of the caller's executor. An error while another read is in progress.
+async fn read(
+    context: &Context,
+    load: fn(&WaylandClipboard) -> std::io::Result<String>,
+) -> Result<String> {
+    let Ok(reader) = context.reader.clone().try_lock_owned() else {
+        return Err("a read of this clipboard is in progress".into());
+    };
+    let (sender, receiver) = oneshot::channel();
+    std::thread::Builder::new().name("clipboard-read".into()).spawn(move || {
+        let text = match reader.as_ref() {
+            Some(clipboard) => load(clipboard).map_err(Into::into),
+            None => Err(closed()),
+        };
+        let _ = sender.send(text);
+    })?;
+    receiver.await.map_err(|_| closed())?
+}
+
+fn write(context: &Context, store: impl FnOnce(&WaylandClipboard)) -> Result<()> {
+    let writer = context.writer.lock().unwrap_or_else(PoisonError::into_inner);
+    store(writer.as_ref().ok_or_else(closed)?);
+
+    Ok(())
 }
 
