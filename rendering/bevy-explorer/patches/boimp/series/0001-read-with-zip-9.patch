From 0000000000000000000000000000000000000000
Subject: read with zip 9
Date: 2026-11-18T12:57:04+00:00

Depend on zip 9 in place of zip 2, without default features: zip before 9.0.5 is open to
GHSA-m665-v7pm-7grj and GHSA-q7v9-x93c-xqv3. In zip 9, file_names yields a result for each
name, so find pixels.png with ZipArchive::index_for_name. Each changed file starts with a
notice of modification.
---
diff --git a/Cargo.toml b/Cargo.toml
index 83eec2385d081870b888e0ca48c14957da3f76bb..d4d2e66e56bd55f03560c6cba22d877d526c1d4a 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,3 +1,4 @@
+# Modified: requires zip 9 (rendering/bevy-explorer/patches/boimp in decentraland/dcl-one).
 [package]
 name = "boimp"
 version = "0.1.1"
@@ -19,7 +20,7 @@ image = "*"
 bytemuck = "*"
 
 # asset loader
-zip = { version = "2", default-features = false }
+zip = { version = "9", default-features = false }
 anyhow = "*"
 serde = { version = "1", features = ["derive"] }
 
diff --git a/src/asset_loader.rs b/src/asset_loader.rs
index 3762b88461dfe40e46717147c78f62b94eee2ad4..26b1fd96a1a4878496247adac17e31248dd5ad4e 100644
--- a/src/asset_loader.rs
+++ b/src/asset_loader.rs
@@ -1,3 +1,4 @@
+// Modified: reads with zip 9 (rendering/bevy-explorer/patches/boimp in decentraland/dcl-one).
 use core::str;
 use std::{
     collections::{BTreeMap, BTreeSet},
@@ -146,7 +147,7 @@ impl AssetLoader for ImposterLoader {
                 );
             }
 
-            let is_indexed = zip.file_names().any(|n| n == "pixels.png");
+            let is_indexed = zip.index_for_name("pixels.png").is_some();
             let (pixels_image, indices_image, vram_bytes) = if is_indexed {
                 let raw_pixels = BufReader::new(zip.by_name("pixels.png")?)
                     .bytes()
