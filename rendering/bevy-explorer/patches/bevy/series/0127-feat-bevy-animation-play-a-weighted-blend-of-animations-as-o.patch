+/// What a transition layer plays: one animation, or a blend of several.
+#[derive(Debug, Clone, Reflect)]
+#[reflect(Clone)]
+enum Layer {
+    Animation(AnimationNodeIndex),
+    Blend(AnimationBlend),
+}
+
+impl Layer {
+    /// The animations this layer plays.
+    fn animations(&self) -> impl Iterator<Item = AnimationNodeIndex> + '_ {
+        let (animation, blend) = match self {
+            Layer::Animation(animation) => (Some(*animation), None),
+            Layer::Blend(blend) => (None, Some(blend.members.iter())),
+        };
+        animation
+            .into_iter()
+            .chain(blend.into_iter().flatten().map(|member| member.animation))
+    }
+
+    fn plays(&self, animation: AnimationNodeIndex) -> bool {
+        self.animations().any(|played| played == animation)
+    }
+
+    /// Whether `other` plays the same thing: the same animation, or a blend of
+    /// the same animations, whatever their weights and order.
+    fn same_as(&self, other: &Layer) -> bool {
+        match (self, other) {
+            (Layer::Animation(a), Layer::Animation(b)) => a == b,
+            (Layer::Blend(a), Layer::Blend(b)) => a.same_members(b),
+            _ => false,
+        }
+    }
+}
+
+/// Several animations that play as one transition layer, started with
+/// [`AnimationTransitions::play_blend`].
+///
+/// The members split the layer's weight in proportion to their own weights,
+/// and share one normalized phase: they start together and reach the end of
+/// their clips together, however long each clip is. A cycle lasts the mean of
+/// the members' clip durations weighted by their weights, so changing the
+/// weights changes the tempo but never the phase. A 1D blend tree of a state
+/// machine plays a walk and a run this way.
+///
+/// The members loop. [`advance_blends`] sets each member's seek time and speed
+/// from the phase, so seek and set the speed here, not on the
+/// [`ActiveAnimation`]s.
+#[derive(Debug, Clone, Reflect)]
+#[reflect(Clone)]
+pub struct AnimationBlend {
+    members: Vec<BlendMember>,
+    /// Where the members are in their cycle, in `[0, 1)`.
+    phase: f32,
+    speed: f32,
+    /// The length of a cycle at speed 1 when the blend last advanced, in
+    /// seconds.
+    cycle: f32,
+    completions: u32,
+}
+
+#[derive(Debug, Clone, Copy, Reflect)]
+#[reflect(Clone)]
+struct BlendMember {
     animation: AnimationNodeIndex,
+    weight: f32,
+}
+
+impl AnimationBlend {
+    /// A blend of `members` at phase 0; an animation listed twice gets the sum
+    /// of its weights.
+    fn new(members: &[(AnimationNodeIndex, f32)]) -> Self {
+        let mut blend = Self {
+            members: Vec::with_capacity(members.len()),
+            phase: 0.0,
+            speed: 1.0,
+            cycle: 0.0,
+            completions: 0,
+        };
+        for &(animation, weight) in members {
+            match blend.member_mut(animation) {
+                Some(member) => member.weight += weight,
+                None => blend.members.push(BlendMember { animation, weight }),
+            }
+        }
+        blend
+    }
+
+    fn member_mut(&mut self, animation: AnimationNodeIndex) -> Option<&mut BlendMember> {
+        self.members
+            .iter_mut()
+            .find(|member| member.animation == animation)
+    }
+
+    fn same_members(&self, other: &AnimationBlend) -> bool {
+        self.members.len() == other.members.len()
+            && other.members.iter().all(|member| {
+                self.members
+                    .iter()
+                    .any(|own| own.animation == member.animation)
+            })
+    }
+
+    /// The member animations and their weights.
+    pub fn members(&self) -> impl Iterator<Item = (AnimationNodeIndex, f32)> + '_ {
+        self.members
+            .iter()
+            .map(|member| (member.animation, member.weight))
+    }
+
+    /// Sets the members' weights, in the order of [`members`](Self::members).
+    /// The phase carries on and nothing fades: the new weights apply when the
+    /// transitions next advance. A negative weight counts as 0.
+    pub fn set_weights(&mut self, weights: impl IntoIterator<Item = f32>) -> &mut Self {
+        for (member, weight) in self.members.iter_mut().zip(weights) {
+            member.weight = weight;
+        }
+        self
+    }
+
+    /// Each member's share of the layer: its weight over the sum of the
+    /// weights, or an equal share when no weight is positive.
+    fn shares(&self) -> impl Iterator<Item = (AnimationNodeIndex, f32)> + '_ {
+        let total: f32 = self
+            .members
+            .iter()
+            .map(|member| member.weight.max(0.0))
+            .sum();
+        let count = self.members.len() as f32;
+        self.members.iter().map(move |member| {
+            let share = if total > 0.0 {
+                member.weight.max(0.0) / total
+            } else {
+                1.0 / count
+            };
+            (member.animation, share)
+        })
+    }
+
+    /// Where the members are in their cycle, in `[0, 1)`: 0 at the start of
+    /// their clips, 0.5 halfway through.
+    pub fn phase(&self) -> f32 {
+        self.phase
+    }
+
+    /// Moves every member to `phase` of its clip, wrapped into `[0, 1)`. Takes
+    /// effect when the blend next advances, and triggers no events on the way.
+    pub fn seek(&mut self, phase: f32) -> &mut Self {
+        self.phase = wrap(phase);
+        self
+    }
+
+    /// The factor applied to the rate at which the phase advances.
+    pub fn speed(&self) -> f32 {
+        self.speed
+    }
+
+    /// Sets the factor applied to the rate at which the phase advances: 1 plays
+    /// a cycle in [`cycle_secs`](Self::cycle_secs), 0 holds the pose and a
+    /// negative speed plays backwards.
+    pub fn set_speed(&mut self, speed: f32) -> &mut Self {
+        self.speed = speed;
+        self
+    }
+
+    /// The length of a cycle at speed 1, in seconds, when the blend last
+    /// advanced: the mean of the durations of the members whose clips are
+    /// loaded, weighted by their weights. It is 0, and the phase holds, until a
+    /// member with weight has its clip loaded.
+    pub fn cycle_secs(&self) -> f32 {
+        self.cycle
+    }
+
+    /// The number of cycles completed since the blend started.
+    pub fn completions(&self) -> u32 {
+        self.completions
+    }
+
+    /// Puts each member at the phase, with the speed that keeps it there
+    /// through [`advance_animations`](crate::advance_animations), and advances
+    /// the phase by `delta` seconds.
+    fn advance(
+        &mut self,
+        player: &mut AnimationPlayer,
+        duration: impl Fn(AnimationNodeIndex) -> Option<f32>,
+        delta: f32,
+    ) {
+        let (mut weighted, mut total) = (0.0, 0.0);
+        for (animation, share) in self.shares() {
+            if let Some(duration) = duration(animation) {
+                weighted += share * duration;
+                total += share;
+            }
+        }
+        self.cycle = if total > 0.0 { weighted / total } else { 0.0 };
+        let rate = if self.cycle > 0.0 {
+            self.speed / self.cycle
+        } else {
+            0.0
+        };
+
+        for member in &self.members {
+            if let (Some(duration), Some(animation)) = (
+                duration(member.animation),
+                player.animation_mut(member.animation),
+            ) {
+                animation
+                    .set_seek_time(self.phase * duration)
+                    .set_speed(rate * duration);
+            }
+        }
+
+        let phase = self.phase + rate * delta;
+        self.completions = self.completions.saturating_add(phase.floor().abs() as u32);
+        self.phase = wrap(phase);
+    }
+}
+
+/// `phase` wrapped into `[0, 1)`.
+fn wrap(phase: f32) -> f32 {
+    let wrapped = phase - phase.floor();
+    if wrapped < 1.0 {
+        wrapped
+    } else {
+        0.0
+    }
 }
 
