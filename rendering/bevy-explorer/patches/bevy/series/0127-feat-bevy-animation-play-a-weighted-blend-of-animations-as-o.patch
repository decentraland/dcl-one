+/// A system that keeps the members of each [`AnimationBlend`] on its phase and
+/// advances the phase. It runs after [`advance_transitions`] and before
+/// [`advance_animations`](crate::advance_animations).
+pub fn advance_blends(
+    mut query: Query<(
+        &mut AnimationTransitions,
+        &mut AnimationPlayer,
+        &AnimationGraphHandle,
+    )>,
+    graphs: Res<Assets<AnimationGraph>>,
+    clips: Res<Assets<AnimationClip>>,
+    time: Res<Time>,
+) {
+    for (mut animation_transitions, mut player, graph) in query.iter_mut() {
+        if !animation_transitions
+            .layers
+            .iter()
+            .any(|layer| matches!(layer.layer, Layer::Blend(_)))
+        {
+            continue;
+        }
+        let Some(graph) = graphs.get(graph) else {
+            continue;
+        };
+        let duration = |animation| match &graph.get(animation)?.node_type {
+            AnimationNodeType::Clip(clip) => clips
+                .get(clip)
+                .map(AnimationClip::duration)
+                .filter(|duration| *duration > 0.0),
+            _ => None,
+        };
+        for layer in &mut animation_transitions.layers {
+            if let Layer::Blend(blend) = &mut layer.layer {
+                blend.advance(&mut player, duration, time.delta_secs());
             }
         }
     }
