@@ -58,9 +58,11 @@ impl ViewNode for TonemappingNode {
             return Ok(());
         }
 
-        let Some(pipeline) = pipeline_cache.get_render_pipeline(view_tonemapping_pipeline.0) else {
+        let Some(pipeline) = pipeline_cache.get_render_pipeline(view_tonemapping_pipeline.id) else {
             return Ok(());
         };
+        // the lookup table of the curve the pipeline draws, which a fallback pipeline keeps
+        let tonemapping = &view_tonemapping_pipeline.tonemapping;
 
         let post_process = target.post_process_write();
         let source = post_process.source;
