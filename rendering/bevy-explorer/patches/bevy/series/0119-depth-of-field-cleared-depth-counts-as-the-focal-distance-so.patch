From 0000000000000000000000000000000000000000
Subject: depth of field: cleared depth counts as the focal distance, so a skybox stays sharp
Date: 2026-11-20T13:41:00+00:00

---
diff --git a/crates/bevy_core_pipeline/src/dof/dof.wgsl b/crates/bevy_core_pipeline/src/dof/dof.wgsl
index 693a7ac19216b53f62e622e610d2bfcf44065aab..4561201c5267debcbce60a992cc560ff0cd3bee7 100644
--- a/crates/bevy_core_pipeline/src/dof/dof.wgsl
+++ b/crates/bevy_core_pipeline/src/dof/dof.wgsl
@@ -142,9 +142,9 @@ fn circle_of_confusion_at(frag_coord: vec2<i32>) -> f32 {
     // Sample the depth. Apply max_depth before the coverage-weighted blend
     // below so that a distant background doesn't swamp the contribution of a
     // partially-covering transparent surface, and cap at a large finite value
-    // so that a cleared depth of 0.0 (infinitely far away under reverse-z, and
-    // max_depth defaults to infinity) can't produce an infinity that would
-    // poison the blend.
+    // so that a depth near 0.0 (far away under reverse-z, and max_depth
+    // defaults to infinity) can't produce an infinity that would poison the
+    // blend.
     let blended_depth = blended_view_depth(frag_coord);
 
     let depth = clamp(blended_depth, focus, dof_params.max_depth);
@@ -163,10 +163,16 @@ fn circle_of_confusion_at(frag_coord: vec2<i32>) -> f32 {
 // The view depth of a pixel as the circle of confusion sees it: the opaque
 // depth with the depth of the transparent surfaces blended in, weighted by how
 // much they cover the pixel, so that they attract focus in proportion to their
-// opacity.
+// opacity. Cleared depth is the backdrop that nothing drew, a skybox: it counts
+// as the focal distance, so the backdrop stays sharp while geometry as far away
+// blurs.
 fn blended_view_depth(frag_coord: vec2<i32>) -> f32 {
     let raw_depth = textureLoad(depth_texture, frag_coord, 0);
-    let opaque_depth = min(min(-depth_ndc_to_view_z(raw_depth), dof_params.max_depth), 3.4e37);
+    let opaque_depth = select(
+        min(min(-depth_ndc_to_view_z(raw_depth), dof_params.max_depth), 3.4e37),
+        dof_params.focal_distance,
+        raw_depth == 0.0,
+    );
     let focus_sample = textureLoad(focus_texture, frag_coord, 0);
     let coverage = clamp(focus_sample.g, 0.0, 1.0);
     return focus_sample.r + (1.0 - coverage) * opaque_depth;
