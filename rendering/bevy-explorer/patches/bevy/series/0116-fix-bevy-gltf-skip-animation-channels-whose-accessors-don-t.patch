+    /// How many curves the clip of a one-animation glTF holds, for its `samplers` and `channels`
+    /// over these accessors:
+    /// 0. two keyframe times;
+    /// 1. two VEC3 floats;
+    /// 2. two VEC4 unsigned ints;
+    /// 3. two SCALAR unsigned ints;
+    /// 4. one keyframe time;
+    /// 5. zero VEC3 floats;
+    /// 6. zero VEC4 floats;
+    /// 7. zero SCALAR floats;
+    /// 8. two SCALAR floats, in a bufferView with a `byteStride` of 4;
+    /// 9. two VEC3 floats, in the same bufferView;
+    /// 10. two VEC3 floats, as keyframe times.
+    #[cfg(feature = "bevy_animation")]
