-        Ok(gltf) => return Ok(gltf),
-        Err(gltf::Error::Validation(errors)) => errors,
+    let gltf = match gltf::Gltf::from_slice(bytes) {
+        Ok(gltf) => gltf,
+        Err(gltf::Error::Validation(errors))
