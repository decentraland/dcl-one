-    let missing_buffer_view = |(path, error): &(gltf::json::Path, Error)| {
-        matches!(error, Error::Missing)
-            && path.0.starts_with("accessors[")
-            && path.0.ends_with(".bufferView")
+    const DRACO: &str = "KHR_draco_mesh_compression";
+    if gltf.document.extensions_used().any(|ext| ext == DRACO) {
+        if let Some(accessor) = gltf
+            .document
+            .meshes()
+            .flat_map(|mesh| mesh.primitives())
+            .filter(|primitive| primitive.extension_value(DRACO).is_some())
+            .flat_map(|primitive| {
+                let attributes = primitive.attributes().map(|(_, accessor)| accessor);
+                primitive.indices().into_iter().chain(attributes)
