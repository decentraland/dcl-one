-    Ok(gltf)
+    // gltf reads `count` elements of `size` bytes, `byteStride` apart, from `offset` in a view,
+    // and computes where they end unchecked: a huge count wraps to a short or empty read
+    for accessor in [&input, &output] {
+        let sparse = accessor.sparse();
+        let reads = [
+            accessor
+                .view()
+                .map(|view| (view, accessor.offset(), accessor.count(), accessor.size())),
+            sparse.as_ref().map(|sparse| {
+                let indices = sparse.indices();
+                let size = indices.index_type().size();
+                (indices.view(), indices.offset(), sparse.count(), size)
+            }),
+            sparse.as_ref().map(|sparse| {
+                let values = sparse.values();
+                (values.view(), values.offset(), sparse.count(), accessor.size())
+            }),
+        ];
+        for (view, offset, count, size) in reads.into_iter().flatten() {
+            let stride = view.stride().unwrap_or(size);
+            if stride < size {
+                return Err(format!(
+                    "{} has a byteStride shorter than its element",
+                    describe(accessor)
+                ));
+            }
+            let end = match count.checked_sub(1) {
+                None => Some(offset),
+                Some(last) => stride
+                    .checked_mul(last)
+                    .and_then(|bytes| bytes.checked_add(size))
+                    .and_then(|bytes| bytes.checked_add(offset)),
+            };
+            if end.is_none_or(|end| end > view.length()) {
+                return Err(format!(
+                    "{} reads past its bufferView",
+                    describe(accessor)
+                ));
+            }
+        }
+    }
+    let values_per_keyframe = match sampler.interpolation() {
+        // an in-tangent, the value and an out-tangent
+        Interpolation::CubicSpline => 3,
+        Interpolation::Linear | Interpolation::Step => 1,
+    };
+    let keyframes = input.count();
+    let values = keyframes.saturating_mul(values_per_keyframe);
+    if output.count() < values {
+        return Err(format!(
+            "output {} has {} values for {keyframes} keyframes",
+            describe(&output),
+            output.count()
+        ));
+    }
+    // an output with no bufferView is zero-filled: gltf yields `count` zeros whatever the
+    // count, so it is capped at what the keyframes can use
+    let targets = match property {
+        Property::MorphTargetWeights => bevy_mesh::morph::MAX_MORPH_WEIGHTS,
+        _ => 1,
+    };
+    if output.view().is_none() && output.count() > values.saturating_mul(targets) {
+        return Err(format!(
+            "output {} has no bufferView and {} values for {keyframes} keyframes",
+            describe(&output),
+            output.count()
+        ));
+    }
+    Ok(node)
