+/// The node an animation channel animates, or why the channel is skipped. The gltf crate
+/// validates none of what is checked here, and its channel reader panics on each of these:
+/// - a target path it does not know (`Target::property` unwraps it);
+/// - a sampler input other than float scalars, or an output whose type does not fit the path
+///   (`read_outputs` hits `unreachable!` for a rotation or weights of another component type;
+///   a translation or scale read from an accessor of another type reads past each element);
+/// - a bufferView `byteStride` smaller than the accessor's element (`[f32; 3]::from_slice`
+///   asserts on the short slice);
+/// - fewer output values than keyframes (the loader indexes the first value of a single
+///   keyframe).
+///
+/// A `KHR_animation_pointer` channel animates the property a JSON pointer names (a material's
+/// emissive, a camera's fov), not a node; `bevy_animation` only drives an entity's components.
+#[cfg(feature = "bevy_animation")]
+fn animated_node<'a>(
+    document: &'a Document,
+    channel: &gltf::animation::Channel<'a>,
+) -> Result<Node<'a>, String> {
+    use gltf::{
+        accessor::{Accessor, DataType, Dimensions},
+        animation::{Interpolation, Property},
+        json::validation::Checked,
+    };
+    let json_target = &document.as_json().animations[channel.animation().index()].channels
+        [channel.index()]
+        .target;
+    if matches!(json_target.path, Checked::Invalid) {
+        return Err("unknown target path".into());
+    }
+    let target = channel.target();
+    let property = target.property();
+    if property == Property::Pointer {
+        return Err(format!(
+            "KHR_animation_pointer to {} (only node transforms and morph weights are animated)",
+            target.animation_pointer().unwrap_or("(no pointer)")
+        ));
+    }
+    let node = target.node_opt().ok_or("no target node")?;
+
+    let sampler = channel.sampler();
+    let (input, output) = (sampler.input(), sampler.output());
+    let describe = |accessor: &Accessor| {
+        format!(
+            "accessor {} ({:?} {:?})",
+            accessor.index(),
+            accessor.dimensions(),
+            accessor.data_type()
+        )
+    };
+    if input.dimensions() != Dimensions::Scalar || input.data_type() != DataType::F32 {
+        return Err(format!("input {} is not float scalars", describe(&input)));
+    }
+    // rotations and weights may also be normalized integers (KHR_mesh_quantization)
+    let (dimensions, integers) = match property {
+        Property::Translation | Property::Scale => (Dimensions::Vec3, false),
+        Property::Rotation => (Dimensions::Vec4, true),
+        Property::MorphTargetWeights => (Dimensions::Scalar, true),
+        Property::Pointer => unreachable!("skipped above"),
+    };
+    let data_type_fits = match output.data_type() {
+        DataType::F32 => true,
+        DataType::I8 | DataType::U8 | DataType::I16 | DataType::U16 => integers,
+        DataType::U32 => false,
+    };
+    if output.dimensions() != dimensions || !data_type_fits {
+        return Err(format!(
+            "output {} does not fit a {property:?} target",
+            describe(&output)
+        ));
+    }
+    for accessor in [&input, &output] {
+        let views = accessor
+            .view()
+            .into_iter()
+            .chain(accessor.sparse().map(|sparse| sparse.values().view()));
+        for view in views {
+            if view.stride().is_some_and(|stride| stride < accessor.size()) {
+                return Err(format!(
+                    "{} has a byteStride shorter than its element",
+                    describe(accessor)
+                ));
+            }
+        }
+    }
+    let values_per_keyframe = match sampler.interpolation() {
+        // an in-tangent, the value and an out-tangent
+        Interpolation::CubicSpline => 3,
+        Interpolation::Linear | Interpolation::Step => 1,
+    };
+    let keyframes = input.count();
+    if output.count() < keyframes.saturating_mul(values_per_keyframe) {
+        return Err(format!(
+            "output {} has {} values for {keyframes} keyframes",
+            describe(&output),
+            output.count()
+        ));
+    }
+    Ok(node)
+}
