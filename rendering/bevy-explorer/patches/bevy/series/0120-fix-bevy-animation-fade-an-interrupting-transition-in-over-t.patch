+/// Each layer's weight, newest first: its share of what the newer layers leave.
+/// The oldest takes the rest, so the weights sum to 1.
+fn weights(layers: &[AnimationTransition]) -> impl Iterator<Item = f32> + '_ {
+    let mut remaining = 1.0;
+    layers.iter().enumerate().rev().map(move |(index, layer)| {
+        let weight = if index == 0 {
+            remaining
+        } else {
+            layer.share * remaining
+        };
+        remaining -= weight;
+        weight
+    })
+}
