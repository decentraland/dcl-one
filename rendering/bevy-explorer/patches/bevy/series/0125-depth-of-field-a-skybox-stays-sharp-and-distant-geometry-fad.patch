+// Computes the circle of confusion of each pixel once, for the depth of field
+// blur passes in `dof.wgsl` to read.
+//
+// Cleared depth is the backdrop that nothing drew, a skybox. It has no
+// distance of its own, so it counts as the focal distance and stays sharp,
+// except near geometry: a backdrop pixel takes the circle of confusion of the
+// geometry around it, less one pixel for each pixel of distance. Geometry
+// blurred against the backdrop then fades into it instead of keeping a sharp
+// outline, since the blur rejects samples much sharper than the pixel it
+// gathers for. The spread is a maximum filter with a falloff along the
+// Manhattan distance, which separates exactly into a horizontal pass and a
+// vertical one.
+
+#import bevy_core_pipeline::fullscreen_vertex_shader::FullscreenVertexOutput
+#import bevy_pbr::mesh_view_bindings::view
+#import bevy_pbr::view_transformations::depth_ndc_to_view_z
+
+// See `DepthOfFieldParams` in `dof.wgsl`.
+struct DepthOfFieldParams {
+    focal_distance: f32,
+    focal_length: f32,
+    coc_scale_factor: f32,
+    max_circle_of_confusion_diameter: f32,
+    max_depth: f32,
+    pad_a: u32,
+    pad_b: u32,
+    pad_c: u32,
+}
+
+// @group(0) @binding(0) is `mesh_view_bindings::view`.
+
+// The depth texture for the main view.
+#ifdef MULTISAMPLED
+@group(0) @binding(1) var depth_texture: texture_depth_multisampled_2d;
+#else   // MULTISAMPLED
+@group(0) @binding(1) var depth_texture: texture_depth_2d;
+#endif  // MULTISAMPLED
+
+// The transparent focus texture, accumulated during the main transparent pass:
+// alpha-weighted view depth in r, total coverage in g.
+#ifdef MULTISAMPLED
+@group(0) @binding(2) var focus_texture: texture_multisampled_2d<f32>;
+#else   // MULTISAMPLED
+@group(0) @binding(2) var focus_texture: texture_2d<f32>;
+#endif  // MULTISAMPLED
+
+// The vertical pass reads the horizontal pass's output.
+@group(0) @binding(3) var spread_texture: texture_2d<f32>;
+
+@group(1) @binding(0) var<uniform> dof_params: DepthOfFieldParams;
+
+// The circle of confusion of geometry at `depth`, before the cap.
+fn circle_of_confusion_for(depth: f32) -> f32 {
+    let focus = dof_params.focal_distance;
+    // This is just the formula from Wikipedia [1].
+    //
+    // [1]: https://en.wikipedia.org/wiki/Circle_of_confusion#Determining_a_circle_of_confusion_diameter_from_the_object_field
+    let candidate_coc = dof_params.coc_scale_factor * abs(depth - focus)
+        / (depth * (focus - dof_params.focal_length));
+    let framebuffer_size = vec2<f32>(textureDimensions(depth_texture));
+    return candidate_coc * framebuffer_size.y;
+}
+
+// The circle of confusion diameter of the pixel at `frag_coord`, with the
+// backdrop at the focal distance.
+fn own_circle_of_confusion(frag_coord: vec2<i32>) -> f32 {
+    let focus = dof_params.focal_distance;
+
+    // Apply max_depth before the coverage-weighted blend below so that a
+    // distant background doesn't swamp the contribution of a partially-covering
+    // transparent surface, and cap at a large finite value so that a depth near
+    // 0.0 (far away under reverse-z, and max_depth defaults to infinity) can't
+    // produce an infinity that would poison the blend.
+    let raw_depth = textureLoad(depth_texture, frag_coord, 0);
+    let opaque_depth = select(
+        min(min(-depth_ndc_to_view_z(raw_depth), dof_params.max_depth), 3.4e37),
+        focus,
+        raw_depth == 0.0,
+    );
+
+    // Blend in the depth of the transparent surfaces, weighted by how much they
+    // cover the pixel, so that they attract focus in proportion to their
+    // opacity.
+    let focus_sample = textureLoad(focus_texture, frag_coord, 0);
+    let coverage = clamp(focus_sample.g, 0.0, 1.0);
+    let blended_depth = focus_sample.r + (1.0 - coverage) * opaque_depth;
+
+    let depth = clamp(blended_depth, focus, dof_params.max_depth);
+    return clamp(circle_of_confusion_for(depth), 0.0, dof_params.max_circle_of_confusion_diameter);
+}
+
+// How far, in pixels, geometry can spread its circle of confusion: the circle
+// of the farthest geometry, whose depth is clamped to max_depth.
+fn spread_reach() -> i32 {
+    let depth = max(min(dof_params.max_depth, 3.4e37), dof_params.focal_distance);
+    let coc = circle_of_confusion_for(depth);
+    return i32(ceil(clamp(coc, 0.0, dof_params.max_circle_of_confusion_diameter)));
+}
+
+fn is_backdrop(frag_coord: vec2<i32>) -> bool {
+    return textureLoad(depth_texture, frag_coord, 0) == 0.0;
+}
+
+// The largest circle of confusion along the row, less the distance to it.
+@fragment
+fn coc_horizontal(in: FullscreenVertexOutput) -> @location(0) vec4<f32> {
+    let frag_coord = vec2<i32>(floor(in.position.xy));
+    let width = i32(textureDimensions(depth_texture).x);
+    let reach = spread_reach();
+    var spread = own_circle_of_confusion(frag_coord);
+    // beyond the reach, no circle is wider than its distance
+    for (var i = 1; i < reach; i += 1) {
+        let falloff = f32(i);
+        let left = frag_coord.x - i;
+        if (left >= 0) {
+            spread = max(spread, own_circle_of_confusion(vec2(left, frag_coord.y)) - falloff);
+        }
+        let right = frag_coord.x + i;
+        if (right < width) {
+            spread = max(spread, own_circle_of_confusion(vec2(right, frag_coord.y)) - falloff);
+        }
+    }
+    return vec4(spread, 0.0, 0.0, 1.0);
+}
+
+// Geometry keeps its own circle of confusion; the backdrop takes the largest
+// in the column of the horizontal pass's spread, less the distance to it.
+@fragment
+fn coc_vertical(in: FullscreenVertexOutput) -> @location(0) vec4<f32> {
+    let frag_coord = vec2<i32>(floor(in.position.xy));
+    if (!is_backdrop(frag_coord)) {
+        return vec4(own_circle_of_confusion(frag_coord), 0.0, 0.0, 1.0);
+    }
+    let height = i32(textureDimensions(depth_texture).y);
+    let reach = spread_reach();
+    var spread = textureLoad(spread_texture, frag_coord, 0).r;
+    // beyond the reach, no circle is wider than its distance
+    for (var i = 1; i < reach; i += 1) {
+        let falloff = f32(i);
+        let up = frag_coord.y - i;
+        if (up >= 0) {
+            spread = max(spread, textureLoad(spread_texture, vec2(frag_coord.x, up), 0).r - falloff);
+        }
+        let down = frag_coord.y + i;
+        if (down < height) {
+            spread = max(spread, textureLoad(spread_texture, vec2(frag_coord.x, down), 0).r - falloff);
+        }
+    }
+    return vec4(max(spread, 0.0), 0.0, 0.0, 1.0);
+}
