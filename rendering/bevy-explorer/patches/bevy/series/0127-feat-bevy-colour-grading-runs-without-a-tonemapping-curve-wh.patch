 #endif
 
+#ifdef UNTONEMAPPED_MIX
+    let untonemapped = color;
+#endif
+
     // tone_mapping
 #ifdef TONEMAP_METHOD_NONE
     color = color;
@@ -390,6 +394,10 @@ fn tone_mapping(in: vec4<f32>, in_color_grading: ColorGrading) -> vec4<f32> {
