+/// Parses and validates a glTF, tolerating two kinds of validation error:
+/// - the gltf crate requires every non-sparse accessor to have a bufferView, but the spec allows
+///   both to be omitted (the accessor is zero-filled, optionally overlaid with sparse data -
+///   blender exports morph targets like this). the accessor readers already yield zeros in that
+///   case. draco-compressed accessors also lack bufferViews but their data is not readable, so
+///   those still fail.
+/// - the gltf crate only allows a required `EXT_texture_webp` behind its own feature, which reads
+///   the extension into a typed field that overrides `source`; this loader reads the extension's
+///   image itself (`prefer_extension_sources`).
+///
+/// Validation reports every error, so when those are the only ones the rest of the document
+/// validated and it is parsed again without validation.
+fn parse_gltf(bytes: &[u8]) -> Result<gltf::Gltf, GltfError> {
+    use gltf::json::validation::Error;
+    let errors = match gltf::Gltf::from_slice(bytes) {
+        Ok(gltf) => return Ok(gltf),
+        Err(gltf::Error::Validation(errors)) => errors,
+        Err(e) => return Err(e.into()),
+    };
+    let missing_buffer_view = |(path, error): &(gltf::json::Path, Error)| {
+        matches!(error, Error::Missing)
+            && path.0.starts_with("accessors[")
+            && path.0.ends_with(".bufferView")
+    };
+    let required_webp = |(path, error): &(gltf::json::Path, Error)| {
+        matches!(error, Error::Unsupported)
+            && path.0.starts_with("extensionsRequired[")
+            && path.0.ends_with("= \"EXT_texture_webp\"")
+    };
+    if !errors
+        .iter()
+        .all(|e| missing_buffer_view(e) || required_webp(e))
+    {
+        return Err(gltf::Error::Validation(errors).into());
+    }
+    let gltf = gltf::Gltf::from_slice_without_validation(bytes)?;
+    if errors.iter().any(missing_buffer_view)
+        && gltf
+            .document
+            .extensions_used()
+            .any(|ext| ext == "KHR_draco_mesh_compression")
+    {
+        return Err(gltf::Error::Validation(errors).into());
+    }
+    Ok(gltf)
+}
