+/// Creates the buffers that hold the skinning matrices of the current and the
+/// previous frame, each `size` bytes.
+fn new_skin_matrices_buffers(device: &RenderDevice, size: u64) -> [Buffer; 2] {
+    core::array::from_fn(|_| {
+        device.create_buffer(&BufferDescriptor {
+            label: Some("skin matrices buffer"),
+            size,
+            usage: BufferUsages::STORAGE,
+            mapped_at_creation: false,
+        })
+    })
+}
+
+/// The shader of the skin matrices compute pass.
+pub(crate) const SKIN_MATRICES_SHADER_HANDLE: Handle<Shader> =
+    weak_handle!("3d0b5b2e-8f43-4c1e-9a57-2f6c1d7e4b90");
+
+/// Invocations per workgroup of the skin matrices dispatch, the
+/// `@workgroup_size` of `skin_matrices.wgsl`.
+const SKIN_MATRICES_WORKGROUP: u32 = 64;
+
+/// Workgroups per row of the skin matrices dispatch. The shader derives the
+/// row length from the dispatch, so only this side chooses it.
+const SKIN_MATRICES_GROUPS_PER_ROW: u32 = 1024;
+
+/// The workgroups, in x and y, that cover `count` skin joints: rows of
+/// [`SKIN_MATRICES_GROUPS_PER_ROW`] workgroups.
+fn skin_matrices_workgroups(count: u32) -> (u32, u32) {
+    let groups = count.div_ceil(SKIN_MATRICES_WORKGROUP);
+    (
+        groups.min(SKIN_MATRICES_GROUPS_PER_ROW),
+        groups.div_ceil(SKIN_MATRICES_GROUPS_PER_ROW),
+    )
+}
+
+/// The compute pipeline that multiplies each joint's world matrix by each
+/// skin's inverse bindpose, queued in the [`PipelineCache`].
+struct SkinMatricesPipeline {
+    layout: BindGroupLayout,
+    id: CachedComputePipelineId,
+}
+
+impl SkinMatricesPipeline {
+    fn new(device: &RenderDevice, pipeline_cache: &PipelineCache) -> Self {
+        let layout = device.create_bind_group_layout(
+            "skin matrices layout",
+            &BindGroupLayoutEntries::sequential(
+                ShaderStages::COMPUTE,
+                (
+                    storage_buffer_read_only_sized(false, None),
+                    storage_buffer_read_only_sized(false, None),
+                    storage_buffer_sized(false, None),
+                ),
+            ),
+        );
+        let id = pipeline_cache.queue_compute_pipeline(ComputePipelineDescriptor {
+            label: Some("skin matrices pipeline".into()),
+            layout: vec![layout.clone()],
+            push_constant_ranges: vec![],
+            shader: SKIN_MATRICES_SHADER_HANDLE,
+            shader_defs: vec![],
+            entry_point: "main".into(),
+            zero_initialize_workgroup_memory: false,
+        });
+        Self { layout, id }
+    }
+}
