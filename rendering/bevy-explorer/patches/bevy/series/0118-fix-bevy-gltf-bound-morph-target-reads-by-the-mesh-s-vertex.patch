+
+    /// A target's declared `count` comes from the file: reads stop at the mesh's vertex count
+    /// instead of allocating what the file declares.
+    #[test]
+    fn morph_target_reads_stop_at_the_vertex_count() {
+        let gltf = parse(
+            br#"
+{
+    "asset": { "version": "2.0" },
+    "buffers": [{ "byteLength": 16 }],
+    "bufferViews": [
+        { "buffer": 0, "byteLength": 4 },
+        { "buffer": 0, "byteOffset": 4, "byteLength": 12 }
+    ],
+    "accessors": [
+        { "componentType": 5126, "count": 4611686018427387904, "type": "VEC3" },
+        {
+            "componentType": 5126, "count": 4611686018427387904, "type": "VEC3",
+            "sparse": {
+                "count": 1,
+                "indices": { "bufferView": 0, "componentType": 5125 },
+                "values": { "bufferView": 1 }
+            }
+        }
+    ],
+    "meshes": [{ "primitives": [{
+        "attributes": {},
+        "targets": [{ "POSITION": 0 }, { "POSITION": 1, "NORMAL": 0 }]
+    }] }]
+}
+"#,
+        );
+        let mut buffer = 0u32.to_le_bytes().to_vec();
+        buffer.extend([1.0f32, 2.0, 3.0].map(f32::to_le_bytes).concat());
+        let primitive = gltf.meshes().next().unwrap().primitives().next().unwrap();
+        assert_eq!(
+            displacements(&primitive, buffer, 2),
+            vec![
+                vec![[Vec3::ZERO; 3]; 2],
+                vec![
+                    [Vec3::new(1.0, 2.0, 3.0), Vec3::ZERO, Vec3::ZERO],
+                    [Vec3::ZERO; 3]
+                ],
+            ]
+        );
+    }
