# Supply-chain hardening:
# - No package can run code at install time. The only package in this lock
#   with an install script is @parcel/watcher (jest's optional file watcher;
#   its binary ships as a platform optionalDependency).
# - New deps get saved with exact versions; ranges make every lockfile
#   regeneration a chance to pull a freshly-compromised patch release.
ignore-scripts=true
save-exact=true
fund=false
