# Supply-chain hardening (pnpm reads the same settings from pnpm-workspace.yaml):
# - No package can run code at install time; allowBuilds lists the packages
#   in our lock with install scripts, none of which needs one here
#   (esbuild ships its binary as a platform optionalDependency, the rest are
#   self-checks or JavaScript fallbacks).
# - New deps get saved with exact versions; ranges make every lockfile
#   regeneration a chance to pull a freshly-compromised patch release.
ignore-scripts=true
save-exact=true
fund=false
