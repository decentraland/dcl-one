{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "stripInternal": true,
    "preserveConstEnums": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2020"],
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["dist", "dist-cjs"]
}
