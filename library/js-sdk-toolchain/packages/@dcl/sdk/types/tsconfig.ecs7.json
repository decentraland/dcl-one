{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "pretty": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "exactOptionalPropertyTypes": false,
    "inlineSourceMap": true,
    "sourceMap": false,
    "removeComments": true,
    "inlineSources": true,
    "useDefineForClassFields": false,
    "preserveConstEnums": true,
    "allowJs": true,
    "jsx": "react",
    "jsxFactory": "ReactEcs.createElement",
    "alwaysStrict": true,
    "strict": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "lib": ["ES2020"],
    "types": ["@dcl/js-runtime"],
    "paths": {
      // hoisted beside @dcl/sdk (npm, yarn), else pnpm's virtual store seen from this file's real path
      "@dcl/asset-packs": ["../../smart-items/dist/index", "../../../../../node_modules/@dcl/smart-items/dist/index"],
      "@dcl/asset-packs/dist/*": ["../../smart-items/dist/*", "../../../../../node_modules/@dcl/smart-items/dist/*"]
    }
  }
}
