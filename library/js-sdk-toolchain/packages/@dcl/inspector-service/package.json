{
  "name": "@dcl/inspector-service",
  "version": "0.1.0",
  "description": "The scene editor's data layer and component model: the Node side that @dcl/sdk-commands runs",
  "devDependencies": {
    "@dcl/ecs": "workspace:*",
    "@dcl/ecs-math": "2.1.0",
    "@dcl/rpc": "1.1.2",
    "@dcl/schemas": "26.5.0",
    "@dcl/sdk": "workspace:*",
    "@dcl/smart-items": "workspace:*",
    "@protobufjs/utf8": "1.1.2",
    "@types/node": "^24.10.1",
    "@types/ws": "8.18.2",
    "@well-known-components/pushable-channel": "1.0.3",
    "ajv": "8.18.0",
    "esbuild": "0.28.0",
    "ethereum-cryptography": "2.2.1",
    "fp-future": "1.0.1",
    "ignore": "7.0.5",
    "long": "5.3.2",
    "protobufjs": "7.6.5",
    "ts-deepmerge": "7.0.3",
    "typescript": "7.0.2",
    "vitest": "1.6.0",
    "ws": "8.22.0"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
