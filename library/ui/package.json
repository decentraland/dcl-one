{
  "name": "@dcl/one-ui",
  "version": "0.11.0",
  "private": true,
  "description": "Shared UI foundations and components for dcl-one, with the Node-only Figma tooling in figma/.",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "bin": {
    "dcl-figma": "./figma/src/cli.ts",
    "figma-agent-kit": "./figma/agent-kit/cli.mjs",
    "figma-key-guard": "./figma/key-guard.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p figma/tsconfig.json && tsc -p figma/review/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && tsx --test figma/review/test/*.test.ts",
    "figma": "cd figma && tsx src/cli.ts",
    "figma:mcp": "cd figma && tsx src/server.ts",
    "key-guard": "node figma/key-guard.mjs",
    "figma:freeze-snapshot": "node figma/scripts/freeze-test-snapshot.mjs",
    "review": "vite --config figma/review/review.vite.config.ts --port 6019 --strictPort",
    "review:build": "vite build --config figma/review/review.vite.config.ts",
    "review:capture": "node figma/review/scripts/capture-review.mjs",
    "review:check": "node figma/review/scripts/check-review.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@figma/code-connect": "2.0.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tanstack/react-store": "0.11.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.5",
    "svgo": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
