{
  // The browser surface consumers compile from source. Also checked with the apps' TypeScript
  // version (typecheck:apps-ts), since consumers build it with their own compiler.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    // `apps/sites` reads shared logic from `library/web-core`, which consumers resolve with the same alias.
    "paths": { "@dcl/one-ui": ["./index.ts"], "@web-core/*": ["../web-core/*"] }
  },
  "include": ["index.ts", "css-modules.d.ts", "components", "apps/sites", "foundations"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.figma.ts"]
}
