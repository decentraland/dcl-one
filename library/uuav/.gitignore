# Generated by Cargo
# will have compiled files and executables
debug
target
.target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# machine-built FFmpeg, mbedTLS and libva (see scripts/build-ffmpeg-*.sh,
# tooling/uuav/fetch-ffmpeg-windows.sh); not committed
.third_party
.ffmpeg-src
.ffmpeg-build
.mbedtls-src
.libva-src
# FFmpeg's configure --help drops this into the cwd
ffbuild

# the build workflow's per-target hash reports
dist/**/*.sha256

# Unity leftovers from the original import
**/*.meta
