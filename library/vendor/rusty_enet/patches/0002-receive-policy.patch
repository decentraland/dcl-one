+// Reuse the peer's dispatch node. A terminal violation replaces any aggregate report.
+pub(crate) unsafe fn enet_peer_receive_limit<S: Socket>(
+    peer: *mut ENetPeer<S>,
+    channel: u8,
+    kind: u8,
+) {
+    if (*peer).receive_terminal {
+        return;
+    }
+    if kind == 1 {
+        (*peer).receive_terminal = true;
+    }
+    if kind == 1 || (*peer).receive_limit == 0 {
+        (*peer).receive_limit = kind;
+        (*peer).receive_limit_channel = channel;
+    }
+    if (*peer).flags & ENET_PEER_FLAG_NEEDS_DISPATCH as u16 != 0 {
+        enet_list_remove(&mut (*peer).dispatch_list);
+    }
+    let queue = &mut (*(*peer).host).dispatch_queue;
+    enet_list_insert(
+        (*queue).sentinel.next,
+        core::ptr::addr_of_mut!((*peer).dispatch_list).cast(),
+    );
+    (*peer).flags |= ENET_PEER_FLAG_NEEDS_DISPATCH as u16;
+}
+
+pub(crate) unsafe fn enet_peer_check_receive_payload<S: Socket>(
+    peer: *mut ENetPeer<S>,
+    channel: u8,
+    length: usize,
+) -> bool {
+    if (*(*peer).host)
+        .receive_policy
+        .is_some_and(|p| length > p.maximum_packet_size)
+    {
+        enet_peer_receive_limit(peer, channel, 1);
+        return false;
+    }
+    !(*peer).receive_terminal
+}
+
+pub(crate) fn enet_receive_charge(length: usize, fragments: u32) -> Option<usize> {
+    let words = (fragments as usize).checked_add(31)?.checked_div(32)?;
+    length
+        .checked_add(words.checked_mul(core::mem::size_of::<u32>())?)?
+        .checked_add(core::mem::size_of::<ENetIncomingCommand>())?
+        .checked_add(core::mem::size_of::<ENetPacket>())
+}
+
+unsafe fn enet_peer_release_receive<S: Socket>(
+    peer: *mut ENetPeer<S>,
+    command: *mut ENetIncomingCommand,
+) {
+    let charge = (*command).receive_charge;
+    if charge != 0 {
+        (*peer).queued_receive_bytes = (*peer)
+            .queued_receive_bytes
+            .checked_sub(charge)
+            .expect("receive charge underflow");
+        (*peer).queued_receive_commands = (*peer)
+            .queued_receive_commands
+            .checked_sub(1)
+            .expect("receive command underflow");
+        (*peer).total_waiting_data = (*peer)
+            .total_waiting_data
+            .checked_sub((*(*command).packet).data_length)
+            .expect("receive payload underflow");
+        (*command).receive_charge = 0;
+    }
+}
+
+// Called only after window/duplicate selection. All allocating branches share this admission.
+unsafe fn enet_peer_allocate_incoming<S: Socket>(
+    peer: *mut ENetPeer<S>,
+    command: *const ENetProtocol,
+    data: *const u8,
+    length: usize,
+    flags: u32,
+    fragments: u32,
+    unreliable: u32,
+    position: ENetListIterator,
+    channel: *mut ENetChannel,
+) -> *mut ENetIncomingCommand {
+    if !enet_peer_check_receive_payload(peer, (*command).header.channel_id, length) {
+        return core::ptr::null_mut();
+    }
+    let charge = if let Some(policy) = (*(*peer).host).receive_policy {
+        let Some(charge) = enet_receive_charge(length, fragments) else {
+            enet_peer_receive_limit(peer, (*command).header.channel_id, 2);
+            return core::ptr::null_mut();
+        };
+        let Some(bytes) = (*peer)
+            .queued_receive_bytes
+            .checked_add(charge)
+            .filter(|v| *v <= policy.maximum_queued_bytes)
+        else {
+            enet_peer_receive_limit(peer, (*command).header.channel_id, 2);
+            return core::ptr::null_mut();
+        };
+        let Some(commands) = (*peer)
+            .queued_receive_commands
+            .checked_add(1)
+            .filter(|v| *v <= policy.maximum_queued_commands)
+        else {
+            enet_peer_receive_limit(peer, (*command).header.channel_id, 3);
+            return core::ptr::null_mut();
+        };
+        // Reservation precedes packet, command and bitmap allocation. enet_malloc aborts on OOM.
+        (*peer).queued_receive_bytes = bytes;
+        (*peer).queued_receive_commands = commands;
+        charge
+    } else {
+        if (*peer).total_waiting_data >= (*(*peer).host).maximum_waiting_data {
+            return core::ptr::null_mut();
+        }
+        0
+    };
+    // The parser bounds fragment count, but internal callers can refuse recoverably too.
+    if fragments > PROTOCOL_MAXIMUM_FRAGMENT_COUNT as u32 {
+        if charge != 0 {
+            (*peer).queued_receive_bytes =
+                (*peer).queued_receive_bytes.checked_sub(charge).unwrap();
+            (*peer).queued_receive_commands =
+                (*peer).queued_receive_commands.checked_sub(1).unwrap();
+        }
+        return core::ptr::null_mut();
+    }
+    let packet = enet_packet_create(data, length, flags);
+    let incoming: *mut ENetIncomingCommand =
+        enet_malloc(Layout::new::<ENetIncomingCommand>()).cast();
+    (*incoming).reliable_sequence_number = (*command).header.reliable_sequence_number;
+    (*incoming).unreliable_sequence_number = unreliable as u16;
+    (*incoming).command = *command;
+    (*incoming).fragment_count = fragments;
+    (*incoming).fragments_remaining = fragments;
+    (*incoming).packet = packet;
+    (*incoming).receive_charge = charge;
+    (*incoming).fragments = core::ptr::null_mut();
+    if fragments != 0 {
+        let words = ((fragments as usize) + 31) / 32;
+        (*incoming).fragments = enet_malloc(Layout::array::<u32>(words).unwrap()).cast();
+        write_bytes((*incoming).fragments, 0, words);
+    }
+    (*packet).reference_count += 1;
+    (*peer).total_waiting_data = (*peer)
+        .total_waiting_data
+        .checked_add(length)
+        .expect("receive payload overflow");
+    enet_list_insert((*position).next, incoming.cast());
+    match (*command).header.command as u32 & ENET_PROTOCOL_COMMAND_MASK {
+        8 | 6 => enet_peer_dispatch_incoming_reliable_commands(peer, channel, incoming),
+        _ => enet_peer_dispatch_incoming_unreliable_commands(peer, channel, incoming),
+    }
+    incoming
+}
