+                    PeerState::HasPeer {
+                        address, peer_ptr, ..
+                    } => {
+                        assert!(initiator);
+                        assert_eq!(address.generation, 2);
+                        assert_eq!(unsafe { (**peer_ptr).0 }, expected_ptr.unwrap());
