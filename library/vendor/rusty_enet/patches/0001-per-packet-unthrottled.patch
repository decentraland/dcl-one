+impl Network {
+    pub fn force_throttle(&mut self, from: usize, to: usize, throttle: u32) {
+        let id = self.resolve_peer(from, to);
+        let peer = self.hosts[from].peer_mut(id);
+        unsafe {
+            (*peer.0).packet_throttle = throttle;
+            (*peer.0).packet_throttle_limit = throttle;
+            (*peer.0).packet_throttle_counter = 0;
+        }
+    }
+}
