{
  "name": "@dcl/hashing",
  "version": "1.0.0",
  "private": true,
  "description": "Decentraland content hashes: hashV0, hashV1 and the ADR-32 and ADR-62 helpers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/dcl-one.git",
    "directory": "library/hashing"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./ADR32": {
      "types": "./dist/ADR32.d.ts",
      "default": "./dist/ADR32.js"
    },
    "./ADR62": {
      "types": "./dist/ADR62.d.ts",
      "default": "./dist/ADR62.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
