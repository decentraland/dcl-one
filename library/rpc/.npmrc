# Supply-chain hardening:
# - No package can run code at install time. The packages in this lock with
#   install scripts are @parcel/watcher (jest's optional file watcher; its
#   binary ships as a platform optionalDependency) and protobufjs (a
#   version-consistency check the package works without).
# - New deps get saved with exact versions; ranges make every lockfile
#   regeneration a chance to pull a freshly-compromised patch release.
ignore-scripts=true
save-exact=true
fund=false
