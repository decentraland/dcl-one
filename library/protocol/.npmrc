# Supply-chain hardening (pnpm reads the same settings from pnpm-workspace.yaml):
# - No package can run code at install time. The only package in our lock
#   with an install script is protobufjs, whose postinstall is a version
#   self-check that nothing depends on (`make install` copies its google
#   well-known types itself).
# - New deps get saved with exact versions; ranges make every lockfile
#   regeneration a chance to pull a freshly-compromised patch release.
ignore-scripts=true
save-exact=true
fund=false
