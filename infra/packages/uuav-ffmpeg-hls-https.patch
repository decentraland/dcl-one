+/* https is served by the embedding's own client through io_open, so no
+ * https protocol is registered; name it from the prefix. */
+static const char *uuav_protocol_name(const char *url)
+{
+    const char *name = avio_find_protocol_name(url);
+    if (!name && av_strstart(url, "https:", NULL))
+        name = "https";
+    return name;
+}
